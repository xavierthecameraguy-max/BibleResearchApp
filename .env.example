# Copy this file to ".env" (same folder) and paste in the keys you have.
# The .env file is private: Git ignores it, so it never goes to GitHub.
# On Netlify, add the same names under Site configuration → Environment variables.
# Leave a line empty if you don't have that key yet; that translation simply won't appear.

# API.Bible (American Bible Society) - for the NKJV and other licensed translations
API_BIBLE_KEY=

# ESV API (Crossway) - https://api.esv.org
ESV_API_KEY=

# NLT API (Tyndale) - https://api.nlt.to
NLT_API_KEY=

# Optional but recommended once the app is online: a private code of your choice.
# The app asks for it once (Settings → Licensed translations), so only you can
# use your API keys through this site.
APP_ACCESS_CODE=

# Optional: which API.Bible translations to show (up to 3 on the free plan).
# Format: ABBR=bibleId|Full name, separated by commas. Default is the NKJV:
# API_BIBLE_BIBLES=NKJV=63097d2a0a2f7db3-01|New King James Version
