# Copy this file to ".env" (same folder) and paste in the keys you have.
# The .env file is private: Git ignores it, so it never goes to GitHub.
# On Netlify, add the same names under Site configuration → Environment variables.
# Leave a line empty if you don't have that key yet; that translation simply won't appear.

# API.Bible (American Bible Society) - for the NKJV and other licensed translations
API_BIBLE_KEY=

# ESV API (Crossway) - https://api.esv.org
ESV_API_KEY=

# NLT API (Tyndale) - https://api.nlt.to
NLT_API_KEY=
